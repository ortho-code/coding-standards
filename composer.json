{
  "name": "ortho-code/coding-standards",
  "description": "OrthoCode's coding standards, distributed with standards-sync",
  "type": "library",
  "keywords": ["coding-standards", "code-quality", "config-sync", "standards"],
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.5",
    "ortho-code/standards-sync": "^0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^12",
    "symplify/easy-coding-standard": "^13.2",
    "rector/rector": "^2.5",
    "phpstan/phpstan": "^2.2",
    "vimeo/psalm": "^6"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "OrthoCode\\CodingStandards\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\OrthoCode\\CodingStandards\\": "tests/"
    }
  },
  "scripts": {
    "app-run-tests": [
      "phpunit"
    ],
    "app-sync": [
      "standards-sync sync"
    ],
    "app-sync-check": [
      "standards-sync sync --check"
    ],
    "app-checks": [
      "@app-sync-check",
      "@app-ecs",
      "@app-phpstan",
      "@app-psalm",
      "@app-rector",
      "@app-run-tests"
    ],
    "app-ecs": [
      "ecs check"
    ],
    "app-ecs-fix": [
      "ecs check --fix"
    ],
    "app-rector": [
      "rector process --dry-run"
    ],
    "app-rector-fix": [
      "rector process"
    ],
    "app-phpstan": [
      "phpstan analyse"
    ],
    "app-psalm": [
      "psalm"
    ]
  }
}
