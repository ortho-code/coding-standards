{
    "extends": [
        "local>ortho-code/coding-standards:renovate-package-preset" // ortho-code coding standards; sync re-adds this entry
    ],
    // The workflows under .github/ are synced from these templates, so an action or runner update has to change both in one pull request.
    "github-actions": {
        "managerFilePatterns": [
            "/^templates/.+\\.ya?ml$/"
        ]
    },
    "packageRules": [
        // The Bitbucket template's image is the application tier's PHP floor, so it moves with that floor in a release of this standard, never on its own.
        {
            "matchFileNames": [
                "templates/project/ci-pipelines.yml"
            ],
            "matchDepNames": [
                "php"
            ],
            "enabled": false
        }
    ]
}
